# Database – use a free online PostgreSQL (no local SQL/server needed)
# Neon (recommended): https://neon.tech → Create project → copy connection string
# Supabase: https://supabase.com → New project → Settings → Database → Connection string (URI)
# Example (Neon):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Session (use a long random string in production)
SESSION_SECRET="your-session-secret-min-32-chars"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="your-cron-secret"

# Football data (optional; for schedule and statistics sync)
FOOTBALL_DATA_ORG_API_KEY=""

# ScoreBat highlights (optional override; public v3 endpoint works by default)
SCOREBAT_HIGHLIGHTS_API_URL="https://www.scorebat.com/video-api/v3/"
# ScoreBat Video API token — sign up free at https://www.scorebat.com/video-api/
# Enables the updated free-feed endpoint and (on paid plans) competition feeds for CL/WC.
SCOREBAT_API_TOKEN=""
# Optional competition slugs when using a paid ScoreBat plan:
# SCOREBAT_UCL_COMPETITION_SLUG="uefa-champions-league"
# SCOREBAT_WC_COMPETITION_SLUG="international-world-cup"
# World Cup Match Center widget embed URL (public token; rendered client-side in an iframe).
NEXT_PUBLIC_SCOREBAT_WC_EMBED_URL="https://www.scorebat.com/embed/league/fifa-world-cup/?token=YOUR_TOKEN&pref=%7B%22nomaxwidth%22%3Atrue%7D"
# World Cup Highlights widget embed URL (video panel; public token).
NEXT_PUBLIC_SCOREBAT_WC_HIGHLIGHTS_URL="https://www.scorebat.com/embed/videopanel/league/fifa-world-cup/?token=YOUR_TOKEN&pref=%7B%22autoplay%22%3Atrue%7D"

# OpenLigaDB World Cup 2026 results (free, key-less; endpoint is fixed in code)
OpenLigaDB_Endpoint="https://api.openligadb.de/getmatchdata/wm26/2026"

# YouTube Data API v3 — official FIFA World Cup 2026 highlights (BACKEND ONLY).
# Create a key at https://console.cloud.google.com → enable "YouTube Data API v3".
# Never expose this key to the frontend.
YOUTUBE_API_KEY=""
# Official FIFA YouTube channel id (defaults to FIFA's main channel in code).
FIFA_YOUTUBE_CHANNEL_ID="UCpcTrCXblq78GZrTUTLWeBw"

# Optional ScoreAxis overrides for official widget pairing.
# Use JSON objects with string keys and string values.
# Example:
# NEXT_PUBLIC_SCOREAXIS_MATCH_IDS_JSON="{\"552049\":\"replace-with-scoreaxis-match-id\"}"
# NEXT_PUBLIC_SCOREAXIS_LEAGUE_IDS_JSON="{\"super lig\":\"replace-with-scoreaxis-league-id\"}"
# NEXT_PUBLIC_SCOREAXIS_TEAM_IDS_JSON="{\"afc ajax\":\"replace-with-scoreaxis-team-id\"}"
NEXT_PUBLIC_SCOREAXIS_MATCH_IDS_JSON=""
NEXT_PUBLIC_SCOREAXIS_LEAGUE_IDS_JSON=""
NEXT_PUBLIC_SCOREAXIS_TEAM_IDS_JSON=""
