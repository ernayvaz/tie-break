{
  "buildCommand": "npm run db:generate && npm run db:migrate:deploy && npm run build",
  "crons": [
    {
      "path": "/api/cron/sync-results",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/sync-stats",
      "schedule": "10 1 * * 1,5"
    },
    {
      "path": "/api/cron/sync-highlights",
      "schedule": "20 1 * * 1,5"
    }
  ]
}

